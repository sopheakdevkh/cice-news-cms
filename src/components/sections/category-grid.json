{
  "collectionName": "components_sections_category_grids",
  "info": {
    "displayName": "Category News",
    "icon": "grid",
    "description": "Multi-column category feed"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "category": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category"
    },
    "columns": {
      "type": "enumeration",
      "enum": [
        "1_col",
        "2_cols",
        "3_cols",
        "4_cols"
      ],
      "default": "4_cols"
    },
    "postLimit": {
      "type": "integer",
      "default": 4
    },
    "showMoreLink": {
      "type": "boolean",
      "default": true
    }
  }
}
